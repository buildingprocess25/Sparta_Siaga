# ============================================================================
# SPARTA SIAGA — Environment Configuration Specification
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (REQUIRED)
# Runtime only; NEVER pass secrets as Docker build arguments.
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>"
JWT_SECRET="<random-secure-secret-at-least-32-characters>"
SPARTA_INTERNAL_WORKER_SECRET="<random-secure-secret-at-least-32-characters>"
PRIVATE_STORAGE_ROOT="/app/storage"

# ----------------------------------------------------------------------------
# 2. DATABASE POOL & TLS CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL_MODE="require"
# Required only when DATABASE_SSL_MODE="verify-full"
DATABASE_SSL_CA_BASE64=""

# ----------------------------------------------------------------------------
# 3. APPLICATION & NETWORK (SERVER & CLIENT)
# ----------------------------------------------------------------------------
PORT=3004
TZ="Asia/Jakarta"
APP_BASE_URL="https://siaga.sparta-alfamart.web.id"
NEXT_PUBLIC_APP_URL="https://siaga.sparta-alfamart.web.id"
NEXT_PUBLIC_APP_NAME="SPARTA Siaga"

# ----------------------------------------------------------------------------
# 4. SSO & SPARTA ECOSYSTEM INTEGRATIONS
# ----------------------------------------------------------------------------
SPARTA_API_URL="https://sparta-api.alfamart.co.id"
SPARTA_LOGIN_URL="https://sparta-login.alfamart.co.id"
NEXT_PUBLIC_BMS_SYSTEM_URL="https://bms.sparta-alfamart.web.id"
NEXT_PUBLIC_BES_SYSTEM_URL="https://bes.sparta-alfamart.web.id"

# ----------------------------------------------------------------------------
# 5. MACHINE-TO-MACHINE INTEGRATION API CREDENTIALS
# Secure server-to-server credentials for SPARTA Maintenance & Engineering sync
# ----------------------------------------------------------------------------
SPARTA_MAINTENANCE_API_KEY=""
SPARTA_MAINTENANCE_API_SECRET=""
ENGINEERING_SUPPORT_API_KEY=""
ENGINEERING_SUPPORT_API_SECRET=""

# ----------------------------------------------------------------------------
# 6. EXTERNAL DISASTER & WEATHER API FEEDS (CENTRALIZED)
# Defaults point to official public endpoints. Override if using internal proxy/mirror.
# ----------------------------------------------------------------------------
# BMKG InaTEWS Feeds
BMKG_AUTOGEMPA_URL="https://data.bmkg.go.id/DataMKG/TEWS/autogempa.json"
BMKG_GEMPATERKINI_URL="https://data.bmkg.go.id/DataMKG/TEWS/gempaterkini.json"
BMKG_GEMPADIRASAKAN_URL="https://data.bmkg.go.id/DataMKG/TEWS/gempadirasakan.json"
BMKG_SHAKEMAP_BASE_URL="https://data.bmkg.go.id/DataMKG/TEWS"

# USGS Real-Time Earthquake GeoJSON Feed
USGS_EARTHQUAKE_FEED_URL="https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson"

# Open-Meteo Weather & Flood Prediction APIs (Copernicus GloFAS)
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_FLOOD_URL="https://flood-api.open-meteo.com/v1/flood"

# RainViewer Radar Weather Maps
RAINVIEWER_RADAR_MAPS_URL="https://api.rainviewer.com/public/weather-maps.json"
RAINVIEWER_TILE_HOST_FALLBACK="https://tilecache.rainviewer.com"

# PetaBencana Crowd-Sourced Field Flood Reports
PETABENCANA_API_URL="https://data.petabencana.id/reports"

# ----------------------------------------------------------------------------
# 7. GOOGLE SHEETS MASTER DATA SYNC (OPTIONAL / BACKUP)
# If unreachable or unconfigured, system falls back to data/stores-master.csv
# ----------------------------------------------------------------------------
GOOGLE_SHEET_ID="1wvweYqTkS4PA1WKXARRn-vubv7qn6lqISHiSdKSZKcg"
GOOGLE_SHEET_EXPORT_URL="https://docs.google.com/spreadsheets/d/1wvweYqTkS4PA1WKXARRn-vubv7qn6lqISHiSdKSZKcg/export?format=csv"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEETS_API_KEY=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ----------------------------------------------------------------------------
# 8. MAP TILE PROVIDERS (CLIENT-SAFE)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_OSM_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_ESRI_DARK_URL="https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_MAP_TILE_ESRI_LIGHT_URL="https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}"
NEXT_PUBLIC_MAP_TILE_OSM_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
NEXT_PUBLIC_MAP_TILE_ESRI_ATTRIBUTION="Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ"

# ----------------------------------------------------------------------------
# 9. WEB PUSH NOTIFICATIONS (VAPID)
# Required for PWA push alerts to Android, iOS, and Desktop.
# Production strictly rejects development fallback keys.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_PUSH_ENABLED=true
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_NOTIFICATION_GATE_REQUIRED=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<base64url-encoded-p256-public-key>"
VAPID_PRIVATE_KEY="<base64url-encoded-p256-private-key>"
VAPID_SUBJECT="mailto:sparta-siaga@alfamart.co.id"

# ----------------------------------------------------------------------------
# 10. DEVELOPMENT & TESTING CONTROLS (DO NOT ENABLE IN PRODUCTION)
# ----------------------------------------------------------------------------
ALLOW_DEV_FALLBACK_DATA=false
NEXT_PUBLIC_ENABLE_ROLE_SIMULATION=false
SPARTA_ALLOW_TEST_SIMULATION=false

# ----------------------------------------------------------------------------
# 11. AUTOMATED EMAIL DISPATCH (SMTP) & TESTING ISOLATION
# ----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
SMTP_FROM="SPARTA Siaga <siaga@sparta-alfamart.web.id>"
APPROVED_TEST_EMAIL_RECIPIENTS=""

# Isolated UAT Database URL (Used when Testing Mode toggle is ON)
SPARTA_ISOLATED_TEST_DATABASE_URL="postgres://avnadmin:<password>@<host>:15196/sparta_siaga_isolated?sslmode=verify-full"

