datasource db {
  provider = "postgresql"
  url      = env("SIAGA_DATABASE_URL")
}

model earthquake_events {
  id                              String                            @id @db.VarChar(128)
  provider_event_id               String?                           @db.VarChar(128)
  source_primary                  String                            @db.VarChar(32)
  magnitude                       Decimal                           @db.Decimal(3, 1)
  depth_km                        Int
  latitude                        Decimal                           @db.Decimal(8, 5)
  longitude                       Decimal                           @db.Decimal(8, 5)
  occurred_at                     DateTime                          @db.Timestamptz(6)
  title                           String
  potensi_tsunami                 Boolean                           @default(false)
  potensi_text                    String?
  felt_area                       String?
  shakemap_url                    String?
  priority_radius_km              Int
  monitoring_radius_km            Int
  first_seen_at                   DateTime                          @default(now()) @db.Timestamptz(6)
  last_seen_at                    DateTime                          @default(now()) @db.Timestamptz(6)
  raw_metadata                    Json?                             @default("{}")
  earthquake_reconciliation_cases earthquake_reconciliation_cases[]
  earthquake_source_events        earthquake_source_events[]

  @@index([latitude, longitude], map: "idx_eq_events_coords")
  @@index([occurred_at(sort: Desc)], map: "idx_eq_events_occurred_at")
  @@index([source_primary], map: "idx_eq_events_source")
}

model earthquake_facility_intensities {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shakemap_id           String               @db.Uuid
  canonical_event_id    String               @db.VarChar(128)
  facility_kind         String               @db.VarChar(16)
  facility_id           String               @db.VarChar(64)
  facility_code         String               @db.VarChar(32)
  facility_name         String?              @db.VarChar(255)
  branch                String               @db.VarChar(64)
  latitude              Float
  longitude             Float
  distance_km           Float
  mmi_raw               Float?
  mmi_rounded           Decimal?             @db.Decimal(4, 2)
  mmi_roman             String               @db.VarChar(8)
  decision_policy       String               @db.VarChar(32)
  discrepancy_vs_radius String               @db.VarChar(32)
  shakemap_version      Int                  @default(1)
  incident_id           String?              @db.VarChar(64)
  notes                 String?
  evaluated_at          DateTime             @default(now()) @db.Timestamptz(6)
  incidents             incidents?           @relation(fields: [incident_id], references: [id], onUpdate: NoAction)
  earthquake_shakemaps  earthquake_shakemaps @relation(fields: [shakemap_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shakemap_id, facility_kind, facility_id, shakemap_version], map: "uq_shakemap_facility_version")
  @@index([decision_policy], map: "idx_facility_intensities_decision")
  @@index([canonical_event_id, branch], map: "idx_facility_intensities_event_branch")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model earthquake_reconciliation_audit {
  id                              String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                         String                          @db.Uuid
  incident_id                     String
  action                          String                          @db.VarChar(16)
  previous_identity               Json
  resulting_identity              Json
  actor_user_id                   String                          @db.VarChar(64)
  notes                           String?
  created_at                      DateTime                        @default(now()) @db.Timestamptz(6)
  earthquake_reconciliation_cases earthquake_reconciliation_cases @relation(fields: [case_id], references: [id], onUpdate: NoAction)
  incidents                       incidents                       @relation(fields: [incident_id], references: [id], onUpdate: NoAction)

  @@index([case_id, created_at(sort: Desc)], map: "idx_reconciliation_audit_case")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model earthquake_reconciliation_cases {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incident_id                     String
  candidate_canonical_event_id    String?                           @db.VarChar(128)
  candidate_location_kind         String?                           @db.VarChar(16)
  candidate_location_id           String?                           @db.VarChar(128)
  reason                          String                            @db.VarChar(64)
  details                         Json                              @default("{}")
  status                          String                            @default("OPEN") @db.VarChar(16)
  resolved_by                     String?                           @db.VarChar(64)
  resolved_at                     DateTime?                         @db.Timestamptz(6)
  created_at                      DateTime                          @default(now()) @db.Timestamptz(6)
  earthquake_reconciliation_audit earthquake_reconciliation_audit[]
  earthquake_events               earthquake_events?                @relation(fields: [candidate_canonical_event_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "earthquake_reconciliation_cas_candidate_canonical_event_id_fkey")
  incidents                       incidents                         @relation(fields: [incident_id], references: [id], onUpdate: NoAction)
}

model earthquake_shakemaps {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonical_event_id              String                            @db.VarChar(128)
  source_provider                 String                            @db.VarChar(32)
  version_number                  Int                               @default(1)
  product_type                    String                            @default("covjson") @db.VarChar(32)
  grid_bounds_x_min               Float
  grid_bounds_x_max               Float
  grid_bounds_y_min               Float
  grid_bounds_y_max               Float
  grid_num_x                      Int
  grid_num_y                      Int
  max_mmi                         Float
  checksum_sha256                 String                            @db.VarChar(64)
  storage_path                    String?                           @db.VarChar(255)
  raw_payload                     Json?
  evaluation_status               String                            @default("PENDING") @db.VarChar(32)
  received_at                     DateTime                          @default(now()) @db.Timestamptz(6)
  evaluated_at                    DateTime?                         @db.Timestamptz(6)
  error_message                   String?
  earthquake_facility_intensities earthquake_facility_intensities[]

  @@unique([canonical_event_id, source_provider, version_number], map: "uq_earthquake_shakemaps_version")
  @@index([canonical_event_id], map: "idx_shakemaps_canonical_event")
  @@index([evaluation_status], map: "idx_shakemaps_evaluation_status")
}

model earthquake_source_events {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonical_event_id String            @db.VarChar(128)
  provider           String            @db.VarChar(32)
  provider_event_id  String            @db.VarChar(128)
  occurred_at        DateTime          @db.Timestamptz(6)
  latitude           Float
  longitude          Float
  magnitude          Decimal           @db.Decimal(3, 1)
  depth_km           Decimal?          @db.Decimal(7, 2)
  raw_payload        Json              @default("{}")
  first_seen_at      DateTime          @default(now()) @db.Timestamptz(6)
  last_seen_at       DateTime          @default(now()) @db.Timestamptz(6)
  earthquake_events  earthquake_events @relation(fields: [canonical_event_id], references: [id], onUpdate: NoAction)

  @@unique([provider, provider_event_id])
  @@index([canonical_event_id], map: "idx_eq_source_canonical")
}

